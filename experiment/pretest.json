<button type="button" onclick="checkQuiz()" style="padding:10px 20px; font-size:16px;">Submit Quiz</button>

</form>

<h2 id="result"></h2>

<script>
function checkQuiz() {
    const correctAnswers = {
        q1: "China",
        q2: "3",
        q3: "Re-crystallisation temperature",
        q4: "3",
        q5: "Compressive Force",
        q6: "1 mm/sec & 5 mm/sec",
        q7: "45,60,90",
        q8: "Both",
        q9: "Ductile",
        q10: "Solid lubricant"
    };

    let score = 0;
    let total = Object.keys(correctAnswers).length;

    for (let key in correctAnswers) {
        let userAns = document.querySelector(`input[name="${key}"]:checked`);
        if (userAns && userAns.value === correctAnswers[key]) {
            score++;
        }
    }

    let accuracy = ((score / total) * 100).toFixed(2);

    document.getElementById("result").innerHTML =
        `<b>Your Score: ${score}/${total}</b><br>Accuracy: <b>${accuracy}%</b>`;
}
</script>
